# API base URL without a trailing slash.
REACT_APP_API_URL=https://api.example.com

# Microsoft Entra SPA configuration. These values are public identifiers,
# not secrets.
REACT_APP_ENTRA_TENANT_ID=replace-with-entra-tenant-id
REACT_APP_ENTRA_CLIENT_ID=replace-with-entra-spa-client-id
REACT_APP_ENTRA_API_SCOPE=api://replace-with-wasabi-api-app-id/WasabiDrive.Access
