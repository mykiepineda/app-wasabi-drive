# API base URL without a trailing slash.
REACT_APP_API_URL=https://api.example.com

# This value is exposed in the browser bundle and must not be treated as a secret.
# The legacy API-key header is preserved only for current RC1 compatibility and
# may change during the future Entra authentication migration.
REACT_APP_API_KEY=replace-with-rc1-api-key

# Microsoft Entra SPA configuration. These values are public identifiers,
# not secrets.
REACT_APP_ENTRA_TENANT_ID=replace-with-entra-tenant-id
REACT_APP_ENTRA_CLIENT_ID=replace-with-entra-spa-client-id
REACT_APP_ENTRA_API_SCOPE=api://replace-with-wasabi-api-app-id/access_as_user
